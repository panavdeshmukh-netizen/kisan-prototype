NODE_ENV=development
# Server port (match bin/www default)
PORT=3000

# Database: either provide a single DATABASE_URL or the DB_* components
# Example DATABASE_URL: postgres://user:password@localhost:5432/appointment_system
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=appointment_system
DB_USER=postgres
DB_PASSWORD=
DB_SSL=false

# JWT Configuration
JWT_SECRET=
JWT_EXPIRES_IN=24h

# Socket CORS origin (frontend URL)
SOCKET_CORS_ORIGIN=

# Password Hashing (Salt rounds)
HASH_SALT=10